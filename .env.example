# Never commit actual secrets. Copy this file to .env locally.
TAVILY_API_KEY=
# Bifrost gateway root URL; the app appends /v1/chat/completions
BIFROST_BASE_URL=http://localhost:8081
# Authenticated local inference proxy bearer token (not the Gemini provider key)
BIFROST_API_KEY=
# Model route configured in Bifrost, e.g. provider/model
BIFROST_MODEL=
